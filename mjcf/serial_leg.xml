                            <geom name="left_wheel_carrier_geom" class="leg_link"
                                  size="0.0558 0.0075 0.0075" euler="0 -15 0"/>
                            <geom name="left_carrier_pin" class="joint_marker"
                                  pos="0.0466542174097 0 0.0125009598784"/>

                            <body name="left_lower_leg_link" pos="0.0843427112999 0.01 -0.1027190243719">
                                <inertial pos="0 0 0" mass="0.349772111111"
                                          diaginertia="9.472994675923e-06 3.240972841707e-03 3.237329382216e-03"/>
                                <joint name="left_lower_leg_joint" pos="-0.1309969287096 0 0.0902180644934"
                                       range="-23 70"/>
                                <geom name="left_lower_leg_geom" class="leg_link"
                                      size="0.1665581481481 0.0075 0.0075" euler="0 34.555326848126 0"/>
                                <geom name="left_lower_leg_pin" class="joint_marker"
                                      pos="-0.1309969287096 0 0.0902180644934"/>
                                <site name="left_lower_leg_rear_connect" pos="-0.071847494811 0.005 0.0494816327711"
                                      size="0.004" rgba="0.86 0.60 0.16 0.75"/>

                                <body name="left_wheel" pos="0.1309969287096 -0.015 -0.0902180644934">
                                    <inertial pos="0 0.005 0" mass="0.353429173529"
                                              diaginertia="0.000223838477 0.000223838477 0.000441786467"/>
                                    <joint name="left_wheel_joint" pos="0 0 0" limited="false"/>
                                    <geom name="left_wheel_geom" class="wheel" fromto="0 0 0 0 0.01 0"
                                          rgba="0.04 0.04 0.045 1"/>
                                    <geom name="left_wheel_hub_geom" type="cylinder" fromto="0 -0.001 0 0 0.011 0"
                                          size="0.028" rgba="0.15 0.16 0.18 1"/>
                                    <geom name="left_wheel_axle_geom" type="cylinder" fromto="0 -0.008 0 0 0.018 0"
                                          size="0.010" rgba="0.21 0.16 0.10 1"/>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>

            <body name="left_rear_upper_link" pos="-0.1014222117603 0.175 -0.0271759997357">
                <inertial pos="0 0 0" mass="0.23625"
                          diaginertia="6.398437500e-06 1.001109375e-03 9.986484375e-04"/>
                <joint name="left_rear_hip_joint" pos="0.1014222117603 0 0.0271759997357" ref="165"/>
                <geom name="left_rear_upper_geom" class="leg_link"
                      size="0.1125 0.0075 0.0075" euler="0 -15 0"/>
                <geom name="left_rear_hip_pin" class="joint_marker"
                      pos="0.1014222117603 0 0.0271759997357"/>
                <site name="left_rear_to_bridge_connect" pos="-0.0081137769408 -0.005 -0.0021740799788"
                      size="0.004" rgba="0.86 0.60 0.16 0.75"/>
                <site name="left_rear_to_lower_connect" pos="-0.1014222117603 -0.005 -0.0271759997357"
                      size="0.004" rgba="0.86 0.60 0.16 0.75"/>
            </body>

            <!-- ========== 右侧五连杆腿 ========== -->
            <body name="right_front_upper_link" pos="0.0547679943505 -0.165 -0.0146750398573">
                <inertial pos="0 0 0" mass="0.13482"
                          diaginertia="3.651375000e-06 1.877543766e-04 1.863500016e-04"/>
                <joint name="right_front_hip_joint" pos="-0.0547679943505 0 0.0146750398573"
                       ref="15" damping="0.05"/>
                <geom name="right_front_upper_geom" class="leg_link"
                      size="0.0642 0.0075 0.0075" euler="0 15 0"/>
                <geom name="right_front_hip_pin" class="joint_marker"
                      pos="-0.0547679943505 0 0.0146750398573"/>

                <body name="right_front_lower_link" pos="0 -0.01 -0.0523939581187">
                    <inertial pos="0 0 0" mass="0.1554"
                              diaginertia="4.2087500e-06 2.8657055e-04 2.8495180e-04"/>
                    <joint name="right_front_knee_joint" pos="0.0547679943505 0 0.0377189182614"/>
                    <geom name="right_front_lower_geom" class="leg_link"
                          size="0.074 0.0075 0.0075" euler="0 -34.555326848126 0"/>
                    <geom name="right_front_knee_pin" class="joint_marker"
                          pos="0.0547679943505 0 0.0377189182614"/>

                    <body name="right_lower_bridge_link" pos="-0.1391107056504 0.01 0.0203682158611">
                        <inertial pos="0 0 0" mass="0.230811"
                                  diaginertia="6.251131250000e-06 9.337426768397e-04 9.313383955897e-04"/>
                        <joint name="right_bridge_joint" pos="0.084342711299 0 -0.0580871341226"/>
                        <geom name="right_lower_bridge_geom" class="leg_link"
                              size="0.10991 0.0075 0.0075" euler="0 34.555326848126 0"/>
                        <geom name="right_bridge_pin" class="joint_marker"
                              pos="0.084342711299 0 -0.0580871341226"/>
                        <site name="right_bridge_rear_connect" pos="-0.0251932774012 -0.005 0.0173507024002"
                              size="0.004" rgba="0.86 0.60 0.16 0.75"/>

                        <body name="right_wheel_carrier_link" pos="-0.1309969287096 0.01 0.0455861742441">
                            <inertial pos="0 0 0" mass="0.11718"
                                      diaginertia="3.173625000e-06 1.238159034e-04 1.225952784e-04"/>
                            <joint name="right_carrier_joint" pos="0.0466542174097 0 0.0125009598784"
                                   range="-50 25"/>
                            <geom name="right_wheel_carrier_geom" class="leg_link"
                                  size="0.0558 0.0075 0.0075" euler="0 -15 0"/>
                            <geom name="right_carrier_pin" class="joint_marker"
                                  pos="0.0466542174097 0 0.0125009598784"/>

                            <body name="right_lower_leg_link" pos="0.0843427112999 -0.01 -0.1027190243719">
                                <inertial pos="0 0 0" mass="0.349772111111"
                                          diaginertia="9.472994675923e-06 3.240972841707e-03 3.237329382216e-03"/>
                                <joint name="right_lower_leg_joint" pos="-0.1309969287096 0 0.0902180644934"
                                       range="-23 70"/>
                                <geom name="right_lower_leg_geom" class="leg_link"
                                      size="0.1665581481481 0.0075 0.0075" euler="0 34.555326848126 0"/>
                                <geom name="right_lower_leg_pin" class="joint_marker"
                                      pos="-0.1309969287096 0 0.0902180644934"/>
                                <site name="right_lower_leg_rear_connect" pos="-0.071847494811 -0.005 0.0494816327711"
                                      size="0.004" rgba="0.86 0.60 0.16 0.75"/>

                                <body name="right_wheel" pos="0.1309969287096 0.015 -0.0902180644934">
                                    <inertial pos="0 -0.005 0" mass="0.353429173529"
                                              diaginertia="0.000223838477 0.000223838477 0.000441786467"/>
                                    <joint name="right_wheel_joint" pos="0 0 0" limited="false"/>
                                    <geom name="right_wheel_geom" class="wheel" fromto="0 0 0 0 -0.01 0"
                                          rgba="0.04 0.04 0.045 1"/>
                                    <geom name="right_wheel_hub_geom" type="cylinder" fromto="0 0.001 0 0 -0.011 0"
                                          size="0.028" rgba="0.15 0.16 0.18 1"/>
                                    <geom name="right_wheel_axle_geom" type="cylinder" fromto="0 0.008 0 0 -0.018 0"
                                          size="0.010" rgba="0.21 0.16 0.10 1"/>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>

            <body name="right_rear_upper_link" pos="-0.1014222117603 -0.175 -0.0271759997357">
                <inertial pos="0 0 0" mass="0.23625"
                          diaginertia="6.398437500e-06 1.001109375e-03 9.986484375e-04"/>
