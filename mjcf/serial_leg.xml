                <geom name="right_rear_upper_geom" class="leg_link"
                      size="0.1125 0.0075 0.0075" euler="0 -15 0"/>
                <geom name="right_rear_hip_pin" class="joint_marker"
                      pos="0.1014222117603 0 0.0271759997357"/>
                <site name="right_rear_to_bridge_connect" pos="-0.0081137769408 0.005 -0.0021740799788"
                      size="0.004" rgba="0.86 0.60 0.16 0.75"/>
                <site name="right_rear_to_lower_connect" pos="-0.1014222117603 0.005 -0.0271759997357"
                      size="0.004" rgba="0.86 0.60 0.16 0.75"/>
            </body>
        </body>
    </worldbody>

    <!-- 闭环约束 -->
    <equality>
        <connect name="left_rear_bridge_loop" site1="left_rear_to_bridge_connect" site2="left_bridge_rear_connect"
                 solref="0.002 1"/>
        <connect name="left_rear_lower_loop" site1="left_rear_to_lower_connect" site2="left_lower_leg_rear_connect"
                 solref="0.002 1"/>
        <connect name="right_rear_bridge_loop" site1="right_rear_to_bridge_connect" site2="right_bridge_rear_connect"
                 solref="0.002 1"/>
        <connect name="right_rear_lower_loop" site1="right_rear_to_lower_connect" site2="right_lower_leg_rear_connect"
                 solref="0.002 1"/>
    </equality>

    <!-- 执行器 -->
    <actuator>
        <motor name="left_front_hip_motor" joint="left_front_hip_joint" gear="1" ctrlrange="-50 50"/>
        <motor name="right_front_hip_motor" joint="right_front_hip_joint" gear="1" ctrlrange="-50 50"/>
        <motor name="left_rear_hip_motor" joint="left_rear_hip_joint" gear="1" ctrlrange="-50 50"/>
        <motor name="right_rear_hip_motor" joint="right_rear_hip_joint" gear="1" ctrlrange="-50 50"/>
        <motor name="left_wheel_motor" joint="left_wheel_joint" gear="1" ctrlrange="-5 5"/>
        <motor name="right_wheel_motor" joint="right_wheel_joint" gear="1" ctrlrange="-5 5"/>
    </actuator>

    <!-- 传感器 -->
    <sensor>
        <gyro name="imu_gyro" site="imu"/>
        <framequat name="imu_quat" objtype="site" objname="imu"/>
        <accelerometer name="imu_accel" site="imu"/>
        <framepos name="base_pos" objtype="site" objname="imu"/>
        <framelinvel name="base_linvel" objtype="site" objname="imu"/>

        <jointpos name="left_front_hip_pos" joint="left_front_hip_joint"/>
        <jointvel name="left_front_hip_vel" joint="left_front_hip_joint"/>
        <jointpos name="left_rear_hip_pos" joint="left_rear_hip_joint"/>
        <jointvel name="left_rear_hip_vel" joint="left_rear_hip_joint"/>
        <jointpos name="right_front_hip_pos" joint="right_front_hip_joint"/>
        <jointvel name="right_front_hip_vel" joint="right_front_hip_joint"/>
        <jointpos name="right_rear_hip_pos" joint="right_rear_hip_joint"/>
        <jointvel name="right_rear_hip_vel" joint="right_rear_hip_joint"/>
        <jointpos name="left_wheel_pos" joint="left_wheel_joint"/>
        <jointvel name="left_wheel_vel" joint="left_wheel_joint"/>
        <jointpos name="right_wheel_pos" joint="right_wheel_joint"/>
        <jointvel name="right_wheel_vel" joint="right_wheel_joint"/>

        <actuatorfrc name="left_front_hip_force" actuator="left_front_hip_motor"/>
        <actuatorfrc name="right_front_hip_force" actuator="right_front_hip_motor"/>
        <actuatorfrc name="left_rear_hip_force" actuator="left_rear_hip_motor"/>
        <actuatorfrc name="right_rear_hip_force" actuator="right_rear_hip_motor"/>
        <actuatorfrc name="left_wheel_force" actuator="left_wheel_motor"/>
        <actuatorfrc name="right_wheel_force" actuator="right_wheel_motor"/>
    </sensor>
</mujoco>
