<mujoco model="serial_five_link_wheel_leg">
    <compiler angle="degree" autolimits="true"/>
    <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

    <visual>
        <global offwidth="1920" offheight="1080"/>
        <quality shadowsize="8192" offsamples="8" numslices="32" numstacks="32"/>
        <map znear="0.01" zfar="50" shadowclip="2.0" shadowscale="0.5"/>
        <headlight ambient="0.22 0.22 0.22" diffuse="0.35 0.35 0.35" specular="0.08 0.08 0.08"/>
    </visual>

    <statistic center="1.0 0 0" extent="6.0"/>

    <default>
        <joint axis="0 1 0" damping="0.01"/>
        <geom rgba="0.25 0.28 0.30 1" contype="1" conaffinity="1"/>
        <default class="leg_link">
            <geom type="box" rgba="0.05 0.05 0.05 1"/>
        </default>
        <default class="joint_marker">
            <geom type="cylinder" size="0.016 0.008 0.016" euler="90 0 0" rgba="0.15 0.15 0.15 1"/>
        </default>
        <default class="wheel">
            <geom type="cylinder" size="0.05" contype="1" conaffinity="1"
                  condim="6" friction="0.8 0.005 0.0001"
                  solref="0.005 1" solimp="0.9 0.95 0.001"/>
        </default>
    </default>

    <asset>
        <texture name="skybox" type="skybox" builtin="gradient"
                 rgb1="0.78 0.84 0.90" rgb2="0.96 0.98 1.00"
                 width="512" height="512"/>
        <material name="ground_mat" rgba="0.55 0.56 0.55 1"
                  reflectance="0.00" specular="0.18" shininess="0.25"/>
        <material name="ramp_mat" rgba="0.50 0.43 0.35 1"
                  reflectance="0.00" specular="0.14" shininess="0.20"/>
        <mesh name="ramp_wedge" file="ramp_wedge.stl"/>
    </asset>

    <worldbody>
        <!-- 斜向主光负责投影，补光只提亮暗部，避免默认单顶灯的块状阴影观感 -->
        <light name="key_light" directional="true" castshadow="true"
               ambient="0.06 0.06 0.06" diffuse="0.78 0.76 0.72" specular="0.18 0.18 0.18"
               pos="-2.5 -3.0 4.0" dir="0.45 0.60 -1"/>
        <light name="fill_light" directional="true" castshadow="false"
               ambient="0.03 0.04 0.05" diffuse="0.22 0.24 0.27" specular="0 0 0"
               pos="3.0 4.0 3.0" dir="-0.50 -0.55 -1"/>

        <!-- 相机 -->
        <camera name="overview" pos="1.6 -2.4 1.1" xyaxes="0.832 0.555 0 -0.210 0.315 0.925"/>

        <!-- 地面 -->
        <geom name="ground" type="plane" size="200 200 0.1" contype="1" conaffinity="1"
              material="ground_mat"
              friction="1.0 0.001 0.0001" condim="6"/>

        <!-- 17° 楔形斜坡，直角三角形截面，底边 1.145m，高 0.6m，宽 2m -->
        <body name="ramp" pos="2.0 0 0">
            <geom name="ramp_geom" type="mesh" mesh="ramp_wedge"
                  contype="1" conaffinity="1" condim="6"
                  friction="1.0 0.001 0.001"
                  material="ramp_mat"/>
        </body>

        <!-- 基座（车身） -->
        <body name="base" pos="0 0 0.245">
            <freejoint name="base_free"/>
            <inertial pos="0 0 0" mass="15.0"
                      diaginertia="0.22517 0.11593 0.115485"/>
            <site name="imu" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
            <geom name="base_body" type="box" size="0.15 0.15 0.025" rgba="0.6 0.6 0.6 1"/>
            <geom name="left_hip_mount" type="box" pos="0 0.155 0" size="0.026 0.005 0.026"
                  rgba="0.21 0.16 0.10 1"/>
            <geom name="right_hip_mount" type="box" pos="0 -0.155 0" size="0.026 0.005 0.026"
                  rgba="0.21 0.16 0.10 1"/>

            <!-- ========== 左侧五连杆腿 ========== -->
            <body name="left_front_upper_link" pos="0.0547679943505 0.165 -0.0146750398573">
                <inertial pos="0 0 0" mass="0.13482"
                          diaginertia="3.651375000e-06 1.877543766e-04 1.863500016e-04"/>
                <joint name="left_front_hip_joint" pos="-0.0547679943505 0 0.0146750398573"
                       ref="15" damping="0.05"/>
                <geom name="left_front_upper_geom" class="leg_link"
                      size="0.0642 0.0075 0.0075" euler="0 15 0"/>
                <geom name="left_front_hip_pin" class="joint_marker"
                      pos="-0.0547679943505 0 0.0146750398573"/>

                <body name="left_front_lower_link" pos="0 0.01 -0.0523939581187">
                    <inertial pos="0 0 0" mass="0.1554"
                              diaginertia="4.2087500e-06 2.8657055e-04 2.8495180e-04"/>
                    <joint name="left_front_knee_joint" pos="0.0547679943505 0 0.0377189182614"/>
                    <geom name="left_front_lower_geom" class="leg_link"
                          size="0.074 0.0075 0.0075" euler="0 -34.555326848126 0"/>
                    <geom name="left_front_knee_pin" class="joint_marker"
                          pos="0.0547679943505 0 0.0377189182614"/>

                    <body name="left_lower_bridge_link" pos="-0.1391107056504 -0.01 0.0203682158611">
