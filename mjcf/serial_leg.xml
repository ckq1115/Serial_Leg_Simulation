                        <joint name="left_bridge_joint" pos="0.084342711299 0 -0.0580871341226"/>
                        <geom name="left_lower_bridge_geom" class="leg_link"
                              size="0.10991 0.0075 0.0075" euler="0 34.555326848126 0"/>
                        <geom name="left_bridge_pin" class="joint_marker"
                              pos="0.084342711299 0 -0.0580871341226"/>
                        <site name="left_bridge_rear_connect" pos="-0.0251932774012 0.005 0.0173507024002"
                              size="0.004" rgba="0.86 0.60 0.16 0.75"/>

                        <body name="left_wheel_carrier_link" pos="-0.1309969287096 -0.01 0.0455861742441">
                            <inertial pos="0 0 0" mass="0.11718"
                                      diaginertia="3.173625000e-06 1.238159034e-04 1.225952784e-04"/>
                            <joint name="left_carrier_joint" pos="0.0466542174097 0 0.0125009598784"
